plugins {
    id 'fabric-loom' version '1.7-SNAPSHOT'
}

version = project.mod_version
group = project.maven_group
base { archivesName = project.archives_base_name }

dependencies {
    minecraft "com.mojang:minecraft:${project.minecraft_version}"
    mappings "net.fabricmc:yarn:${project.yarn_mappings}:v2"
    modImplementation "net.fabricmc:fabric-loader:${project.loader_version}"
    modImplementation "net.fabricmc.fabric-api:fabric-api:${project.fabric_version}"
}

processResources {
    inputs.property "version", project.version
    filesMatching("fabric.mod.json") { expand "version": project.version }
}

tasks.withType(JavaCompile).configureEach { it.options.release = 21 }
java {
    sourceCompatibility = JavaVersion.VERSION_21
    targetCompatibility = JavaVersion.VERSION_21
    withSourcesJar()
}

org.gradle.jvmargs=-Xmx2G
minecraft_version=1.21.1
yarn_mappings=1.21.1+build.3
loader_version=0.16.5
fabric_version=0.105.0+1.21.1
mod_version=1.0.0
maven_group=com.example
archives_base_name=simple-tpa

# Simple TPA (Fabric 1.21.1, server-side)

Build: JDK 21 + internet
    gradle wrapper --gradle-version 8.10
    ./gradlew build
-> build/libs/simple-tpa-1.0.0.jar  (วางใน mods ของเซิร์ฟเวอร์ + Fabric API) ผู้เล่นไม่ต้องลงมอด

Commands (ทุกคนใช้ได้)
  /tpa <player>        ขอเทเลพอร์ตไปหาผู้เล่นนั้น
  /tpahere <player>    ขอให้ผู้เล่นนั้นเทเลพอร์ตมาหาเรา
  /tpaccept [player]   ยอมรับคำขอ
  /tpdeny [player]     ปฏิเสธคำขอ

Config: config/simpletpa.json

pluginManagement {
    repositories {
        maven { url = 'https://maven.fabricmc.net/' }
        mavenCentral()
        gradlePluginPortal()
    }
}

@echo off
REM ต้องติดตั้ง JDK 21 และ Gradle 8.10 ก่อน (gradle ต้องอยู่ใน PATH)
gradle build
echo.
echo ไฟล์ .jar อยู่ในโฟลเดอร์ build\libs
pause
